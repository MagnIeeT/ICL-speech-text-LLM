# ============================================================
# ICL Speech-Text LLM — environment template
# Copy to .env and fill in real paths for your machine.
# .env is gitignored; never commit real paths/credentials.
# ============================================================

# --- Project Root and Base Paths ---
PROJECT_ROOT=.
BASE_DATA_DIR=./data
BASE_OUTPUT_DIR=./results/symbol_training
CHECKPOINT_DIR=./results/checkpoints
METRICS_DIR=./results/metrics
LOGS_DIR=./results/logs
LOGS_INFERENCE_DIR=./results/logs_inference

# --- Model Weights / HuggingFace IDs ---
QWEN_MODEL_NAME=Qwen/Qwen2-Audio-7B-Instruct
FLAMINGO_MODEL_NAME=nvidia/audio-flamingo-3-hf
# SALMONN = Whisper encoder + BEATs encoder + Vicuna-13B LLM.
# salmonn_v1.pth: https://huggingface.co/tsinghua-ee/SALMONN
# BEATs cpt2:     https://huggingface.co/WeiChihChen/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2
# Whisper + Vicuna auto-download from the HF ids below on first run.
SALMONN_SOURCE_PATH=../SALMONN
SALMONN_CKPT_PATH=./weights/SALMONN/salmonn_v1.pth
BEATS_CKPT_PATH=./weights/SALMONN/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2.pt
SALMONN_TOKENIZER_NAME=lmsys/vicuna-13b-v1.1
WHISPER_MODEL_NAME=openai/whisper-large-v2
LLAMA_MODEL_NAME=lmsys/vicuna-13b-v1.1

# --- HuggingFace Cache ---
HF_HOME=./cache/huggingface
TRANSFORMERS_CACHE=./cache/huggingface

# ============================================================
# Datasets — <NAME>_{TRAIN,VAL,TEST}_PATH; datasets stored as HF
# audio-dict shards also set a matching _LOOKUP path.
# ============================================================

# VoxCeleb (sentiment)
VOXCELEB_TRAIN_PATH=./data/voxceleb/train
VOXCELEB_VAL_PATH=./data/voxceleb/validation
VOXCELEB_TEST_PATH=./data/voxceleb/test
VOXCELEB_TRAIN_LOOKUP=./data/voxceleb/train_audio_lookup
VOXCELEB_VAL_LOOKUP=./data/voxceleb/validation_audio_lookup
VOXCELEB_TEST_LOOKUP=./data/voxceleb/test_audio_lookup

# HVB (dialogue acts)
HVB_TRAIN_PATH=./data/hvb/train
HVB_VAL_PATH=./data/hvb/validation
HVB_TEST_PATH=./data/hvb/test
HVB_TRAIN_LOOKUP=./data/hvb/train_audio_lookup
HVB_VAL_LOOKUP=./data/hvb/validation_audio_lookup
HVB_TEST_LOOKUP=./data/hvb/test_audio_lookup

# MELD (emotion)
MELD_TRAIN_PATH=./data/meld/train

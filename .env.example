# ============================================================
# ICL Speech-Text LLM — environment template
# Copy to .env and fill in real paths for your machine.
# .env is gitignored; never commit real paths/credentials.
# ============================================================

# --- Project Root and Base Paths ---
PROJECT_ROOT=.
BASE_DATA_DIR=./data
BASE_OUTPUT_DIR=./results/symbol_training
CHECKPOINT_DIR=./results/checkpoints
METRICS_DIR=./results/metrics
LOGS_DIR=./results/logs
LOGS_INFERENCE_DIR=./results/logs_inference

# --- Model Weights / HuggingFace IDs ---
QWEN_MODEL_NAME=Qwen/Qwen2-Audio-7B-Instruct
FLAMINGO_MODEL_NAME=nvidia/audio-flamingo-3-hf
# SALMONN = Whisper encoder + BEATs encoder + Vicuna-13B LLM.
# salmonn_v1.pth: https://huggingface.co/tsinghua-ee/SALMONN
# BEATs cpt2:     https://huggingface.co/WeiChihChen/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2
# Whisper + Vicuna auto-download from the HF ids below on first run.
SALMONN_SOURCE_PATH=../SALMONN
SALMONN_CKPT_PATH=./weights/SALMONN/salmonn_v1.pth
BEATS_CKPT_PATH=./weights/SALMONN/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2.pt
SALMONN_TOKENIZER_NAME=lmsys/vicuna-13b-v1.1
WHISPER_MODEL_NAME=openai/whisper-large-v2
LLAMA_MODEL_NAME=lmsys/vicuna-13b-v1.1

# --- HuggingFace Cache ---
HF_HOME=./cache/huggingface
TRANSFORMERS_CACHE=./cache/huggingface

# ============================================================
# Datasets — <NAME>_{TRAIN,VAL,TEST}_PATH; datasets stored as HF
# audio-dict shards also set a matching _LOOKUP path.
# ============================================================

# HVB (dialogue acts)
HVB_TRAIN_PATH=./data/hvb/train
HVB_VAL_PATH=./data/hvb/validation
HVB_TEST_PATH=./data/hvb/test
HVB_TRAIN_LOOKUP=./data/hvb/train_audio_lookup
HVB_VAL_LOOKUP=./data/hvb/validation_audio_lookup
HVB_TEST_LOOKUP=./data/hvb/test_audio_lookup

# CREMA-D (emotion)
CREMAD_TRAIN_PATH=./data/cremad/train
CREMAD_VAL_PATH=./data/cremad/validation
CREMAD_TEST_PATH=./data/cremad/test
CREMAD_TRAIN_LOOKUP=./data/cremad/train_audio_lookup
CREMAD_VAL_LOOKUP=./data/cremad/validation_audio_lookup
CREMAD_TEST_LOOKUP=./data/cremad/test_audio_lookup

# RAVDESS-Song (song emotion, held-out)
RAVDESS_SONG_TRAIN_PATH=./data/ravdess_song/train
RAVDESS_SONG_VAL_PATH=./data/ravdess_song/validation
RAVDESS_SONG_TEST_PATH=./data/ravdess_song/test
RAVDESS_SONG_TRAIN_LOOKUP=./data/ravdess_song/train_audio_lookup
RAVDESS_SONG_VAL_LOOKUP=./data/ravdess_song/validation_audio_lookup
RAVDESS_SONG_TEST_LOOKUP=./data/ravdess_song/test_audio_lookup

# Skit-S2I (speech-to-intent, held-out)
SKIT_S2I_TRAIN_PATH=./data/skit_s2i/train
SKIT_S2I_VAL_PATH=./data/skit_s2i/validation
SKIT_S2I_TEST_PATH=./data/skit_s2i/test

# Google Speech Commands (keyword spotting, held-out)
SPEECH_COMMANDS_VAL_PATH=./data/speech_commands/validation
SPEECH_COMMANDS_TEST_PATH=./data/speech_commands/test

# MInDS-14 (banking intent) — en trained; fr/ko held-out
MINDS14_EN_TRAIN_PATH=./data/minds14_en/train
MINDS14_EN_VAL_PATH=./data/minds14_en/validation
MINDS14_EN_TEST_PATH=./data/minds14_en/test
MINDS14_FR_TRAIN_PATH=./data/minds14_fr/train
MINDS14_FR_VAL_PATH=./data/minds14_fr/validation
MINDS14_FR_TEST_PATH=./data/minds14_fr/test
MINDS14_KO_TRAIN_PATH=./data/minds14_ko/train
MINDS14_KO_VAL_PATH=./data/minds14_ko/validation
MINDS14_KO_TEST_PATH=./data/minds14_ko/test

# HeySQuAD (spoken question answering)
HEYSQUAD_TRAIN_PATH=./data/heysquad/train
HEYSQUAD_VAL_PATH=./data/heysquad/validation
HEYSQUAD_TEST_PATH=./data/heysquad/test

# Clustering eval — user-defined 3-cluster taxonomies (built by utils/build_custom_taxonomy.py)
MINDS14_FR_CAT3_PATH=./data/minds14_fr_cat3
MINDS14_KO_CAT3_PATH=./data/minds14_ko_cat3
SKIT_CAT3_PATH=./data/skit_s2i_cat3
